{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FurryManager",
  "version": "0.5.0",
  "identifier": "app.furrymanager.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FurryManager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "FurryManager",
    "shortDescription": "Локальный менеджер артов",
    "longDescription": "Локальный менеджер фурри-артов: теги, коллекции, группы, умный поиск и мобильный доступ. Всё хранится на вашем компьютере.",
    "resources": {
      "../sidecar/dist": "sidecar",
      "../sidecar/main.py": "sidecar/main.py",
      "../sidecar/requirements.txt": "sidecar/requirements.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
